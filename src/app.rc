#include <windows.h>
#include "resource.h"

// RT_MANIFEST (24), id 1 = process manifest. Windows 2000 ignores it; XP uses it for themed controls.
1 24 "app.manifest"

// 48/32/16 px, 32-bit BMP images with AND masks (no PNG entries: Win2000 can't read those).
// Regenerate from icon/navi2k.png if the artwork changes.
IDI_APPICON ICON "navi2k.ico"

// Playlist name prompt (new / rename). Caption is set at runtime.
IDD_NAME DIALOGEX 0, 0, 230, 58
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Playlist"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "&Name:", -1, 7, 10, 26, 8
    EDITTEXT        IDC_NAME_EDIT, 36, 8, 187, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 119, 37, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 173, 37, 50, 14
END

// File > Settings: two property-sheet pages.
IDD_SET_SERVER DIALOGEX 0, 0, 262, 212
STYLE DS_SHELLFONT | WS_CHILD | WS_CAPTION
CAPTION "Server"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Navidrome server", -1, 7, 7, 248, 96
    LTEXT           "&Address:", -1, 14, 22, 52, 8
    EDITTEXT        IDC_SET_URL, 70, 20, 178, 14, ES_AUTOHSCROLL
    LTEXT           "For example http://192.168.1.10:4533", -1, 70, 36, 178, 8
    LTEXT           "&User name:", -1, 14, 52, 52, 8
    EDITTEXT        IDC_SET_USER, 70, 50, 178, 14, ES_AUTOHSCROLL
    LTEXT           "&Password:", -1, 14, 70, 52, 8
    EDITTEXT        IDC_SET_PASSWORD, 70, 68, 178, 14, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "", IDC_SET_PWHINT, 70, 84, 178, 16
    GROUPBOX        "Secure connections (HTTPS)", -1, 7, 109, 248, 62
    AUTOCHECKBOX    "If HTTPS fails, use this plain-HTTP &LAN address instead:", IDC_SET_FALLBACK, 14, 122, 236, 10
    EDITTEXT        IDC_SET_LANURL, 26, 135, 222, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "Accept un&trusted certificates (only on networks you trust)", IDC_SET_UNTRUSTED, 14, 155, 236, 10
    PUSHBUTTON      "T&est Connection", IDC_SET_TEST, 7, 180, 66, 14
    LTEXT           "", IDC_SET_TESTRESULT, 80, 178, 175, 30
END

IDD_SET_PLAYBACK DIALOGEX 0, 0, 262, 212
STYLE DS_SHELLFONT | WS_CHILD | WS_CAPTION
CAPTION "Playback"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Streaming", -1, 7, 7, 248, 46
    LTEXT           "&Quality:", -1, 14, 22, 52, 8
    COMBOBOX        IDC_SET_QUALITY, 70, 20, 110, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Navidrome converts each track to MP3 at this bitrate.", -1, 14, 38, 236, 8
    GROUPBOX        "Audio output", -1, 7, 59, 248, 74
    LTEXT           "&Device:", -1, 14, 74, 52, 8
    COMBOBOX        IDC_SET_DEVICE, 70, 72, 178, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Buffer:", -1, 14, 92, 52, 8
    COMBOBOX        IDC_SET_BUFFER, 70, 90, 178, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "A longer buffer copes better with a slow network; a shorter one makes volume and seeking respond faster.", -1, 14, 108, 236, 20
    GROUPBOX        "Scrobbling", -1, 7, 139, 248, 46
    AUTOCHECKBOX    "&Report plays to Navidrome", IDC_SET_SCROBBLE, 14, 152, 236, 10
    LTEXT           "Updates play counts, and Last.fm if it's linked in Navidrome. A play counts after half the track or 4 minutes.", -1, 26, 164, 224, 18
END

IDD_SET_DISPLAY DIALOGEX 0, 0, 262, 212
STYLE DS_SHELLFONT | WS_CHILD | WS_CAPTION
CAPTION "Display"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Track lists", -1, 7, 7, 248, 74
    AUTOCHECKBOX    "Show &favorites (the heart column and Library > Favorites)", IDC_SET_SHOWFAV, 14, 21, 236, 10
    AUTOCHECKBOX    "Show &ratings (the star column)", IDC_SET_SHOWRATING, 14, 36, 236, 10
    LTEXT           "Hiding these changes nothing on the server: your favorites and ratings are kept, and show again when you turn them back on.", -1, 14, 54, 236, 20
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Navi2K Player - Navidrome client\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "ProductName", "Navi2K Player\0"
            VALUE "ProductVersion", "0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
