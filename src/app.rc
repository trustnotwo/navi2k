#include <windows.h>
#include "resource.h"

// RT_MANIFEST (24), id 1 = process manifest. Windows 2000 ignores it; XP uses it for themed controls.
1 24 "app.manifest"

// 48/32/16 px, 32-bit BMP images with AND masks (no PNG entries: Win2000 can't read those).
// Regenerate from icon/navi2k.png if the artwork changes.
IDI_APPICON ICON "navi2k.ico"

// Playlist name prompt (new / rename). Caption is set at runtime.
IDD_NAME DIALOGEX 0, 0, 230, 58
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Playlist"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "&Name:", -1, 7, 10, 26, 8
    EDITTEXT        IDC_NAME_EDIT, 36, 8, 187, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 119, 37, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 173, 37, 50, 14
END

// Playlist > Edit details: name and description (the Subsonic playlist comment).
IDD_PLAYLIST DIALOGEX 0, 0, 250, 132
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit Playlist"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "&Name:", -1, 7, 10, 42, 8
    EDITTEXT        IDC_NAME_EDIT, 52, 8, 191, 14, ES_AUTOHSCROLL
    LTEXT           "&Description:", -1, 7, 30, 42, 8
    EDITTEXT        IDC_PL_COMMENT, 52, 28, 191, 74, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 139, 111, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 193, 111, 50, 14
END

// File > Settings: two property-sheet pages.
IDD_SET_SERVER DIALOGEX 0, 0, 262, 212
STYLE DS_SHELLFONT | WS_CHILD | WS_CAPTION
CAPTION "Server"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Navidrome server", -1, 7, 7, 248, 96
    LTEXT           "&Address:", -1, 14, 22, 52, 8
    EDITTEXT        IDC_SET_URL, 70, 20, 178, 14, ES_AUTOHSCROLL
    LTEXT           "For example http://192.168.1.10:4533", -1, 70, 36, 178, 8
    LTEXT           "&User name:", -1, 14, 52, 52, 8
    EDITTEXT        IDC_SET_USER, 70, 50, 178, 14, ES_AUTOHSCROLL
    LTEXT           "&Password:", -1, 14, 70, 52, 8
    EDITTEXT        IDC_SET_PASSWORD, 70, 68, 178, 14, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "", IDC_SET_PWHINT, 70, 84, 178, 16
    GROUPBOX        "Secure connections (HTTPS)", -1, 7, 109, 248, 62
    AUTOCHECKBOX    "If HTTPS fails, use this plain-HTTP &LAN address instead:", IDC_SET_FALLBACK, 14, 122, 236, 10
    EDITTEXT        IDC_SET_LANURL, 26, 135, 222, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "Accept un&trusted certificates (only on networks you trust)", IDC_SET_UNTRUSTED, 14, 155, 236, 10
    PUSHBUTTON      "T&est Connection", IDC_SET_TEST, 7, 180, 66, 14
    LTEXT           "", IDC_SET_TESTRESULT, 80, 178, 175, 30
END

IDD_SET_PLAYBACK DIALOGEX 0, 0, 262, 258
STYLE DS_SHELLFONT | WS_CHILD | WS_CAPTION
CAPTION "Playback"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Streaming", -1, 7, 7, 248, 54
    LTEXT           "&Quality:", -1, 14, 22, 52, 8
    COMBOBOX        IDC_SET_QUALITY, 70, 20, 140, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Navidrome converts each track to MP3 at this bitrate. Lossless plays FLAC files untouched (about 1 Mbps; other formats as 320 kbps MP3).", -1, 14, 38, 236, 18
    GROUPBOX        "Audio output", -1, 7, 65, 248, 74
    LTEXT           "&Device:", -1, 14, 80, 52, 8
    COMBOBOX        IDC_SET_DEVICE, 70, 78, 178, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Buffer:", -1, 14, 98, 52, 8
    COMBOBOX        IDC_SET_BUFFER, 70, 96, 178, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "A longer buffer copes better with a slow network; a shorter one makes volume and seeking respond faster.", -1, 14, 114, 236, 20
    GROUPBOX        "Scrobbling", -1, 7, 145, 248, 46
    AUTOCHECKBOX    "&Report plays to Navidrome", IDC_SET_SCROBBLE, 14, 158, 236, 10
    LTEXT           "Updates play counts, and Last.fm if it's linked in Navidrome. A play counts after half the track or 4 minutes.", -1, 26, 170, 224, 18
    GROUPBOX        "Between tracks", -1, 7, 197, 248, 46
    AUTOCHECKBOX    "&Gapless: play the next track with no pause", IDC_SET_GAPLESS, 14, 210, 236, 10
    LTEXT           "The next track starts loading a few seconds early. MP3s can keep a few milliseconds of silence from the encoder.", -1, 26, 222, 224, 18
END

IDD_SET_DISPLAY DIALOGEX 0, 0, 262, 258
STYLE DS_SHELLFONT | WS_CHILD | WS_CAPTION
CAPTION "Display"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Track lists", -1, 7, 7, 248, 74
    AUTOCHECKBOX    "Show &favorites (the heart column and Library > Favorites)", IDC_SET_SHOWFAV, 14, 21, 236, 10
    AUTOCHECKBOX    "Show &ratings (the star column)", IDC_SET_SHOWRATING, 14, 36, 236, 10
    LTEXT           "Hiding these changes nothing on the server: your favorites and ratings are kept, and show again when you turn them back on.", -1, 14, 54, 236, 20
    GROUPBOX        "Notification area", -1, 7, 87, 248, 60
    AUTOCHECKBOX    "Show an &icon in the notification area", IDC_SET_TRAYICON, 14, 101, 236, 10
    AUTOCHECKBOX    "&Minimize to the notification area", IDC_SET_TRAYMIN, 26, 116, 224, 10
    LTEXT           "Click the icon to bring the player back; right-click it for playback controls.", -1, 26, 129, 224, 16
    GROUPBOX        "Keyboard", -1, 7, 153, 248, 50
    AUTOCHECKBOX    "Media &keys control the player even when it's in the background", IDC_SET_MEDIAKEYS, 14, 167, 236, 10
    LTEXT           "Turn this off if another program should get the media keys. Ctrl+P, Ctrl+B, Ctrl+N work in the player.", -1, 26, 180, 224, 18
    GROUPBOX        "Album and artist pages", -1, 7, 209, 248, 44
    AUTOCHECKBOX    "Show &descriptions from Last.fm", IDC_SET_LASTFM, 14, 222, 236, 10
    LTEXT           "Navidrome gets these from Last.fm, so Last.fm must be turned on in Navidrome. Click a long description to read all of it.", -1, 26, 235, 224, 16
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Navi2K Player - Navidrome client\0"
            VALUE "FileVersion", "1.1.0\0"
            VALUE "ProductName", "Navi2K Player\0"
            VALUE "ProductVersion", "1.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
